{
  "course": "07min",
  "voice": "onyx",
  "model": "gpt-4o-mini-tts",
  "items": [
    {
      "id": "07min-001",
      "file": "../07min/001.mp3",
      "text": "楽な姿勢になってください。",
      "wait_ms": 2800
    },
    {
      "id": "07min-002",
      "file": "../07min/002.mp3",
      "text": "仰向けでも、横向きでも、座ったままでも大丈夫です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-003",
      "file": "../07min/003.mp3",
      "text": "身体を正しく整えようとしなくて構いません。",
      "wait_ms": 2800
    },
    {
      "id": "07min-004",
      "file": "../07min/004.mp3",
      "text": "今いちばん楽に感じる姿勢を選びましょう。",
      "wait_ms": 2800
    },
    {
      "id": "07min-005",
      "file": "../07min/005.mp3",
      "text": "まずは、呼吸を観察します。",
      "wait_ms": 2800
    },
    {
      "id": "07min-006",
      "file": "../07min/006.mp3",
      "text": "息を吸っています。",
      "wait_ms": 2800
    },
    {
      "id": "07min-007",
      "file": "../07min/007.mp3",
      "text": "そして、息を吐いています。",
      "wait_ms": 8000
    },
    {
      "id": "07min-008",
      "file": "../07min/008.mp3",
      "text": "呼吸を深くしようとせず、今の速さのままで大丈夫です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-009",
      "file": "../07min/009.mp3",
      "text": "少しずつ、吐く息だけを長くしてみましょう。",
      "wait_ms": 2800
    },
    {
      "id": "07min-010",
      "file": "../07min/010.mp3",
      "text": "無理のないところまで息を吐きます。",
      "wait_ms": 8000
    },
    {
      "id": "07min-011",
      "file": "../07min/011.mp3",
      "text": "そして、身体が自然に息を吸うのを待ちます。",
      "wait_ms": 8000
    },
    {
      "id": "07min-012",
      "file": "../07min/012.mp3",
      "text": "もう一度、ゆっくり吐きます。",
      "wait_ms": 8000
    },
    {
      "id": "07min-013",
      "file": "../07min/013.mp3",
      "text": "では、額に意識を向けます。",
      "wait_ms": 2800
    },
    {
      "id": "07min-014",
      "file": "../07min/014.mp3",
      "text": "眉間に力が入っていたら、少しだけ広げるように緩めます。",
      "wait_ms": 4500
    },
    {
      "id": "07min-015",
      "file": "../07min/015.mp3",
      "text": "目の周りも、休ませましょう。",
      "wait_ms": 3800
    },
    {
      "id": "07min-016",
      "file": "../07min/016.mp3",
      "text": "今日はもう、何かを注意深く見張らなくて大丈夫です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-017",
      "file": "../07min/017.mp3",
      "text": "奥歯を少し離します。",
      "wait_ms": 2800
    },
    {
      "id": "07min-018",
      "file": "../07min/018.mp3",
      "text": "唇も、舌も、顎も、楽にします。",
      "wait_ms": 2800
    },
    {
      "id": "07min-019",
      "file": "../07min/019.mp3",
      "text": "次に、肩を耳の方へ持ち上げてみましょう。",
      "wait_ms": 4500
    },
    {
      "id": "07min-020",
      "file": "../07min/020.mp3",
      "text": "少しだけ力を入れます。",
      "wait_ms": 4500
    },
    {
      "id": "07min-021",
      "file": "../07min/021.mp3",
      "text": "では、吐く息と一緒に、肩を下ろします。",
      "wait_ms": 2800
    },
    {
      "id": "07min-022",
      "file": "../07min/022.mp3",
      "text": "首と肩に残っていた力が、下へ流れていきます。",
      "wait_ms": 2800
    },
    {
      "id": "07min-023",
      "file": "../07min/023.mp3",
      "text": "両腕の重さを感じます。",
      "wait_ms": 2800
    },
    {
      "id": "07min-024",
      "file": "../07min/024.mp3",
      "text": "肘から先。",
      "wait_ms": 2800
    },
    {
      "id": "07min-025",
      "file": "../07min/025.mp3",
      "text": "手首。",
      "wait_ms": 2600
    },
    {
      "id": "07min-026",
      "file": "../07min/026.mp3",
      "text": "手のひら。",
      "wait_ms": 2600
    },
    {
      "id": "07min-027",
      "file": "../07min/027.mp3",
      "text": "指先。",
      "wait_ms": 2600
    },
    {
      "id": "07min-028",
      "file": "../07min/028.mp3",
      "text": "何かを握っていた手を、今は開いておきましょう。",
      "wait_ms": 4500
    },
    {
      "id": "07min-029",
      "file": "../07min/029.mp3",
      "text": "胸やお腹に意識を向けます。",
      "wait_ms": 2800
    },
    {
      "id": "07min-030",
      "file": "../07min/030.mp3",
      "text": "呼吸に合わせて、少し動いています。",
      "wait_ms": 2800
    },
    {
      "id": "07min-031",
      "file": "../07min/031.mp3",
      "text": "お腹をへこませたり、姿勢を保ったりしなくて大丈夫です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-032",
      "file": "../07min/032.mp3",
      "text": "身体の内側にも、休むための場所を作ります。",
      "wait_ms": 2800
    },
    {
      "id": "07min-033",
      "file": "../07min/033.mp3",
      "text": "腰。",
      "wait_ms": 2600
    },
    {
      "id": "07min-034",
      "file": "../07min/034.mp3",
      "text": "太もも。",
      "wait_ms": 2600
    },
    {
      "id": "07min-035",
      "file": "../07min/035.mp3",
      "text": "膝。",
      "wait_ms": 2600
    },
    {
      "id": "07min-036",
      "file": "../07min/036.mp3",
      "text": "ふくらはぎ。",
      "wait_ms": 2600
    },
    {
      "id": "07min-037",
      "file": "../07min/037.mp3",
      "text": "足首。",
      "wait_ms": 2600
    },
    {
      "id": "07min-038",
      "file": "../07min/038.mp3",
      "text": "足の裏。",
      "wait_ms": 2600
    },
    {
      "id": "07min-039",
      "file": "../07min/039.mp3",
      "text": "脚全体の重さを、下へ預けます。",
      "wait_ms": 4500
    },
    {
      "id": "07min-040",
      "file": "../07min/040.mp3",
      "text": "今、身体のどこかに力が残っていても、失敗ではありません。",
      "wait_ms": 2800
    },
    {
      "id": "07min-041",
      "file": "../07min/041.mp3",
      "text": "気づいた場所から、一つずつ緩めれば十分です。",
      "wait_ms": 4500
    },
    {
      "id": "07min-042",
      "file": "../07min/042.mp3",
      "text": "今日起きたことが、頭に浮かんでくるかもしれません。",
      "wait_ms": 2800
    },
    {
      "id": "07min-043",
      "file": "../07min/043.mp3",
      "text": "会話。",
      "wait_ms": 2600
    },
    {
      "id": "07min-044",
      "file": "../07min/044.mp3",
      "text": "仕事。",
      "wait_ms": 2600
    },
    {
      "id": "07min-045",
      "file": "../07min/045.mp3",
      "text": "できなかったこと。",
      "wait_ms": 2600
    },
    {
      "id": "07min-046",
      "file": "../07min/046.mp3",
      "text": "明日の予定。",
      "wait_ms": 2600
    },
    {
      "id": "07min-047",
      "file": "../07min/047.mp3",
      "text": "今は、それらに答えを出す時間ではありません。",
      "wait_ms": 2800
    },
    {
      "id": "07min-048",
      "file": "../07min/048.mp3",
      "text": "頭の中に置いたまま、少し距離を取ってみましょう。",
      "wait_ms": 2800
    },
    {
      "id": "07min-049",
      "file": "../07min/049.mp3",
      "text": "今夜休んだからといって、何かを放棄したことにはなりません。",
      "wait_ms": 2800
    },
    {
      "id": "07min-050",
      "file": "../07min/050.mp3",
      "text": "休むことも、明日の自分に渡す準備の一つです。",
      "wait_ms": 2800
    },
    {
      "id": "07min-051",
      "file": "../07min/051.mp3",
      "text": "ゆっくり息を吐きます。",
      "wait_ms": 8000
    },
    {
      "id": "07min-052",
      "file": "../07min/052.mp3",
      "text": "身体を、今いる場所に預けます。",
      "wait_ms": 4500
    },
    {
      "id": "07min-053",
      "file": "../07min/053.mp3",
      "text": "眠ろうと頑張らなくても大丈夫です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-054",
      "file": "../07min/054.mp3",
      "text": "横になり、目を閉じているだけでも、身体は少しずつ休んでいます。",
      "wait_ms": 2800
    },
    {
      "id": "07min-055",
      "file": "../07min/055.mp3",
      "text": "今日は、ここまでで十分です。",
      "wait_ms": 3800
    },
    {
      "id": "07min-056",
      "file": "../07min/056.mp3",
      "text": "もう頑張らなくて大丈夫です。",
      "wait_ms": 3800
    }
  ]
}
